# Server Configuration
HOST=0.0.0.0
PORT=4000
ENVIRONMENT=development
REQUEST_TIMEOUT=15.0

# When true, platforms without live credentials generate authentic deterministic simulations
# When false, platforms without live credentials return explicit authentication errors
ENABLE_SIMULATION_FALLBACK=true

# 1. Telegram Bot API (https://core.telegram.org/bots/api)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Discord Webhook API (https://discord.com/developers/docs/resources/webhook)
DISCORD_WEBHOOK_URL=

# 3. Slack Incoming Webhook (https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=

# 4. Mastodon REST API v1 (https://docs.joinmastodon.org/methods/statuses/)
MASTODON_ACCESS_TOKEN=
MASTODON_INSTANCE_URL=https://mastodon.social

# 5. Reddit OAuth2 API (https://www.reddit.com/dev/api/)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=test
